; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Dealing with Stuff"
run/main_scene="res://scenes/levels/apartament/apartament_room.tscn"
config/features=PackedStringArray("4.4", "Forward Plus")
config/icon="res://scenes/globals/icon.svg"

[autoload]

BattleScene="*res://scenes/globals/battle_scene.tscn"
Globals="*res://scenes/globals/globals.gd"
PauseMenu="*res://scenes/menus/pause_menu.tscn"
Dialogue="*res://scenes/globals/dialogue.tscn"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=2
window/stretch/mode="canvas_items"

