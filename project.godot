config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Dealing with Stuff"
run/main_scene="uid://ilg00dhpijt0"
config/features=PackedStringArray("4.6", "Forward Plus")
boot_splash/show_image=false
config/icon="res://scenes/globals/icon.svg"

[autoload]

